# Copiar a .env.instructor (ignorado por Git). NO distribuir el fichero cumplimentado.
# La exportacion lee los origenes; este fichero no crea bases, usuarios ni contrasenas en Azure.
AZURE_TENANT_ID=<tenant-del-instructor>
AZURE_SUBSCRIPTION_ID=<suscripcion-azure-de-los-origenes>
AZURE_RESOURCE_GROUP=<grupo-de-recursos>
FABRIC_CAPACITY_ID=<capacidad-fabric>
PROYECTO=frasohome-instructor
ENTORNO=dev
WORKSPACE_DATOS_NOMBRE=
WORKSPACE_ING_NOMBRE=
WORKSPACE_ANA_NOMBRE=
WS_DATOS_ID=<id-workspace-datos>
WS_ING_ID=<id-workspace-ingenieria>
WS_ANA_ID=<id-workspace-analitica>
ENV_FWK_ID=<id-environment-env-fwk>
LAKEHOUSE_ESQUEMA=dbo
DATA_ROOT=data
# Origenes existentes: lectura mediante Entra / clave Cosmos de SOLO LECTURA.
SQL_SOURCE_SERVER=<servidor>.database.windows.net
SQL_SOURCE_DATABASE=frasohome-oltp
SQL_SOURCE_CONNECTION_STRING=
SQL_SOURCE_USER=
SQL_SOURCE_PASSWORD=
COSMOS_SOURCE_ACCOUNT=<cuenta-cosmos>
COSMOS_SOURCE_ENDPOINT=https://<cuenta-cosmos>.documents.azure.com:443/
COSMOS_SOURCE_DATABASE=frasohome
COSMOS_SOURCE_READONLY_KEY=
COSMOS_SOURCE_CONNECTION_STRING=
# Si la clave queda vacia, el exportador la obtiene en memoria con Azure CLI.
# Recursos opcionales del instructor para demos SQL; los alumnos NO los necesitan.
SQL_LAB_DATABASE=frasohome-workshop-instructor
SQL_LAB_SERVER=<servidor-sql-del-laboratorio>.database.windows.net
SQL_LAB_ADMIN_USER=fsh_lab_admin
SQL_LAB_ADMIN_PASSWORD=<generar-localmente>
SQL_LAB_READER_USER=fsh_lab_lector
SQL_LAB_READER_PASSWORD=<generar-localmente>
SQL_LAB_EDITOR_USER=fsh_lab_editor
SQL_LAB_EDITOR_PASSWORD=<generar-localmente>
SQL_LAB_CONNECTION_STRING=
COSMOS_LAB_DATABASE=frasohome-workshop-instructor
COSMOS_LAB_ACCOUNT=<cuenta-cosmos-del-laboratorio>
COSMOS_LAB_ENDPOINT=https://<cuenta-cosmos-del-laboratorio>.documents.azure.com:443/
COSMOS_LAB_CONNECTION_STRING=
# Cosmos usa identidades Entra/RBAC o claves, no usuarios SQL con contrasena.
