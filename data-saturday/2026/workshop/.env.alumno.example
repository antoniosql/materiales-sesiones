# Copiar a .env.alumno (ignorado por Git). Cada alumno usa SU tenant y capacidad Fabric.
# Formato dotenv; no es un script PowerShell. No incluir claves SQL/Cosmos: no son necesarias.
AZURE_TENANT_ID=<tenant-del-alumno>
FABRIC_CAPACITY_ID=<capacidad-activa-del-alumno>
PROYECTO=fsh-alumno01
ENTORNO=dev
# Si se dejan vacios, los nombres se calculan como <PROYECTO>-datos/ing/ana-dev.
WORKSPACE_DATOS_NOMBRE=
WORKSPACE_ING_NOMBRE=
WORKSPACE_ANA_NOMBRE=
WS_DATOS_ID=<id-workspace-datos>
WS_ING_ID=<id-workspace-ingenieria>
WS_ANA_ID=<id-workspace-analitica>
ENV_FWK_ID=<id-environment-env-fwk>
LAKEHOUSE_ESQUEMA=dbo
DATA_ROOT=data
