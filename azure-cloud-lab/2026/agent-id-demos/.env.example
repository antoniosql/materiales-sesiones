# =====================================================================================
#  entra-agent-id-demos · variables de entorno
#  Demos de «Identidad, acceso y ciclo de vida de agentes con Microsoft Entra Agent ID»
#  (Azure Cloud Lab 2026 · caso FraSoHome)
#
#  Copia este fichero a .env (setup.ps1 lo hace por ti) y rellena lo marcado con «←».
#  .env está en .gitignore: nunca lo subas al repositorio.
# =====================================================================================

# --- 1 · Tenant de Microsoft Entra ---------------------------------------------------
# ← ID del tenant de demo (Entra → Overview → Tenant ID)
TENANT_ID=
# Dominio con el que se crean los UPN de las personas del escenario
TENANT_DOMAIN=frasohome.onmicrosoft.com
# ← Nuria, la administradora que prepara y ejecuta las demos.
#   Roles: Agent ID Administrator, Conditional Access Administrator, Lifecycle Workflows Administrator,
#   Attribute Definition Administrator, Attribute Assignment Administrator, Security Operator,
#   User Administrator y Groups Administrator.
ADMIN_UPN=nuria@frasohome.onmicrosoft.com

# --- 2 · Inicio de sesión en Microsoft Graph -----------------------------------------
# Aplicación pública con la que Nuria inicia sesión (delegado). Por defecto,
# «Microsoft Graph Command Line Tools». Cámbiala solo si tu tenant la bloquea.
GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# device = código de dispositivo (funciona en cualquier terminal) · interactive = abre el navegador
GRAPH_LOGIN=device

# --- 3 · Azure ---------------------------------------------------------------------------
# ← Suscripción donde se despliega todo
SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-frasohome-agents
# Región con Foundry Agent Service, el modelo elegido y Container Apps
LOCATION=swedencentral
# ← 3–8 caracteres en minúsculas. Nombres globales: stfrasohome<sufijo>, acrfrasohome<sufijo>, aif-frasohome-<sufijo>
NAME_SUFFIX=

# --- 4 · Foundry (puerta 2) -----------------------------------------------------------------
# true  = infra/main.bicep crea la cuenta, el proyecto y el despliegue del modelo
# false = reutilizas un proyecto existente y rellenas FOUNDRY_PROJECT_ENDPOINT
DEPLOY_FOUNDRY=true
# Solo si DEPLOY_FOUNDRY=false: https://<cuenta>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_PROJECT_NAME=fs-agentes-prj
FOUNDRY_MODEL=gpt-4.1-mini
FOUNDRY_MODEL_VERSION=2025-04-14
# Capacidad del despliegue GlobalStandard (miles de tokens por minuto)
FOUNDRY_MODEL_CAPACITY=30
# ← Tras `agentid foundry identidades`: identidad compartida del proyecto (el «antes» de la demo 2)
FOUNDRY_SHARED_IDENTITY_ID=
# Identidad propia de frasohome-returns. Vacío = se busca por nombre.
FOUNDRY_AGENT_IDENTITY_ID=

# --- 5 · Copilot Studio (puerta 1) -------------------------------------------------------------
# Object ID de la identidad de agente del Asistente de Devoluciones
# (Copilot Studio → Settings → Advanced → Metadata). Vacío = se busca por nombre visible.
COPILOT_AGENT_IDENTITY_ID=

# --- 6 · Agente propio fs-triage-devoluciones (puerta 3) -----------------------------------------
# Cada cuántos segundos revisa el buzón
TRIAGE_POLL_SECONDS=60

# --- 7 · Personas del escenario ------------------------------------------------------------------
USAGE_LOCATION=ES
# Contraseña común para los usuarios de demo. Vacío = una aleatoria por usuario, mostrada una sola vez.
DEMO_USER_PASSWORD=

# --- 8 · Acceso condicional --------------------------------------------------------------------------
# enabled | enabledForReportingButNotEnforced | disabled
CA_AG_01_STATE=enabled
CA_AG_02_STATE=enabledForReportingButNotEnforced

# --- 9 · Datos y estado local ---------------------------------------------------------------------------
# Rutas relativas a la raíz del repositorio (o absolutas)
CASE_DATA_DIR=datos/caso
BUZON_JSON=datos/buzon/correos.json
STATE_DIR=state

# --- 10 · Referencia: variables de las apps en Container Apps -----------------------------------------------
# No hace falta rellenarlas: infra/apps.bicep las inyecta en cada contenedor.
# Se documentan para depurar o para lanzar el servidor MCP en local (python apps/fs-devoluciones-mcp/server.py).
#
# fs-devoluciones-mcp
#   STORAGE_ACCOUNT=stfrasohome<sufijo>
#   DEVOLUCIONES_CONTAINER=devoluciones
#   DEVOLUCIONES_BLOB=devoluciones_online.csv
#   PRODUCTOS_BLOB=productos.csv
#   PORT=8000
#
# fs-triage-devoluciones (solo funciona dentro de Azure: necesita la managed identity)
#   AZURE_TENANT_ID=<TENANT_ID>
#   AZURE_CLIENT_ID=<client id de id-fs-triage>
#   BLUEPRINT_APP_ID=<appId del blueprint>
#   AGENT_IDENTITY_CLIENT_ID=<client id de la identidad de agente>
#   STORAGE_ACCOUNT=stfrasohome<sufijo>
#   BUZON_CONTAINER=buzon-devoluciones
#   RESULTADOS_CONTAINER=triage-resultados
#   POLL_SECONDS=60
