# =====================================================================
#  Semantic Debt · demos de Microsoft 365 Live 2026
#  Copia este fichero a .env y rellénalo. .env está en .gitignore.
# =====================================================================

# --- Tenant -----------------------------------------------------------
TENANT_ID=00000000-0000-0000-0000-000000000000
TENANT_DOMAIN=frasohome.onmicrosoft.com
# Host de SharePoint (sin https://)
SP_HOST=frasohome.sharepoint.com
# Cuenta admin con la que preparas el tenant. Nunca se usa para evaluar.
ADMIN_UPN=nuria@frasohome.onmicrosoft.com

# --- Autenticación ----------------------------------------------------
# app       = registro de aplicación propio (CLIENT_ID + certificado o secreto). Recomendado y necesario para PnP.
# delegated = sin registro: el admin inicia sesión con código de dispositivo en las apps públicas de
#             Microsoft (Graph Command Line Tools y Azure CLI). Las etiquetas y el agente se hacen en la UI.
AUTH_MODE=app

# --- Registro de aplicación en Entra ID (solo AUTH_MODE=app) -----------
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Opción A (recomendada): certificado. Python usa la clave PEM; PnP usa el PFX o la huella.
CERT_THUMBPRINT=
CERT_PEM_KEY_PATH=
CERT_PFX_PATH=
CERT_PFX_PASSWORD=
# Opción B: secreto (sin certificado no se puede usar PnP app-only)
CLIENT_SECRET=

# --- Personas de la demo ------------------------------------------------
# Si el usuario ya existe se reutiliza y la limpieza no lo borra.
LAURA_UPN=laura.p@frasohome.onmicrosoft.com
LAURA_DISPLAY_NAME=Laura P.
# Vacío = se genera una contraseña y se muestra una sola vez
LAURA_PASSWORD=
PACO_UPN=paco.r@frasohome.onmicrosoft.com
PACO_DISPLAY_NAME=Paco R.
PACO_PASSWORD=
USAGE_LOCATION=ES
# skuPartNumber separados por comas (GET /subscribedSkus). Laura necesita M365 + Copilot.
LAURA_LICENSE_SKUS=SPE_E5,Microsoft_365_Copilot
PACO_LICENSE_SKUS=SPE_E5

# --- Grupo de Finanzas (destinatario del cifrado de la etiqueta) --------
FINANZAS_GROUP_ALIAS=FS-Finanzas

# --- Datos del caso FraSoHome -------------------------------------------
# Carpeta con fact_transacciones.csv y crm.csv
CASE_DATA_DIR=C:\repos\materiales-sesiones\frasohome-agents-foundry\case\data
# Carpeta con los FS-KB-*.md (o .docx con el mismo nombre, que tienen prioridad)
CASE_KB_DIR=C:\repos\materiales-sesiones\frasohome-agents-foundry\case\kb

# --- Salidas locales ------------------------------------------------------
OUTPUT_DIR=output
STATE_DIR=state

# --- Etiquetas de sensibilidad ------------------------------------------------
# graph  = POST assignSensitivityLabel (API medida: hay que habilitar la facturación en Graph)
# manual = el script lista qué fichero etiquetar a mano en Word/SharePoint
LABEL_APPLY_METHOD=graph
# interactive = Connect-IPPSSession con ADMIN_UPN; app = certificado (Exchange.ManageAsApp + rol Compliance Administrator)
PURVIEW_PS_AUTH=interactive

# --- Columna Dominio de la biblioteca oficial --------------------------
# taxonomy = metadatos administrados con PnP.PowerShell (enlazada al term store)
# choice   = columna de opción, sin PowerShell
DOMINIO_COLUMN_MODE=taxonomy

# --- Purview Unified Catalog (glosario) -----------------------------------
PURVIEW_ENDPOINT=https://api.purview-service.microsoft.com
PURVIEW_API_VERSION=2026-03-20-preview
# Id del dominio de gobierno donde vive el término (debe existir y estar publicado para publicar términos)
PURVIEW_DOMAIN_ID=

# --- Copilot Chat (evaluación "antes") ---------------------------------------
# graph  = https://graph.microsoft.com/beta/copilot/conversations (permisos documentados)
# workiq = https://workiq.svc.cloud.microsoft/rest (rellena WORKIQ_SCOPE)
COPILOT_CHAT_ENDPOINT=graph
WORKIQ_SCOPE=
TIMEZONE=Europe/Madrid

# --- Copilot Studio (agente "después") ----------------------------------------
PP_ENVIRONMENT_ID=
AGENT_SCHEMA_NAME=fs_asistenteComercial
AGENT_DISPLAY_NAME=Asistente Comercial FraSoHome
AGENT_SOLUTION=FraSoHomeDemos
# Plantilla exportada con `semdebt agent extract-template` tras montar el agente la primera vez
AGENT_TEMPLATE_FILE=copilot-studio/asistente-comercial.template.yaml
